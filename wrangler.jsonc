{
  "name": "svrvs-rythm",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/dl/*"]
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "svrvs-rythm-media" }],
  "d1_databases": [{ "binding": "DB", "database_name": "rythm", "database_id": "e5c05a2a-3cbb-4fd4-a48e-305cb9968536", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
